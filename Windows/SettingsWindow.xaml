<Window x:Class="TodoEdge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TodoEdge settings"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Background="White">
  <StackPanel Margin="20">
    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>

    <TextBlock Text="Claude API key" Margin="0,16,0,4" FontWeight="SemiBold"/>
    <PasswordBox x:Name="KeyBox" Padding="4,4"/>
    <TextBlock Margin="0,4,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap">
      Create one at
      <Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Link_RequestNavigate">console.anthropic.com</Hyperlink>.
      It is encrypted with your Windows account and stored only on this PC.
    </TextBlock>

    <TextBlock Text="Model" Margin="0,14,0,4" FontWeight="SemiBold"/>
    <ComboBox x:Name="ModelBox" IsEditable="True">
      <ComboBoxItem Content="claude-haiku-5-5"/>
      <ComboBoxItem Content="claude-sonnet-5-5"/>
      <ComboBoxItem Content="claude-opus-5-5"/>
    </ComboBox>
    <TextBlock Margin="0,4,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
               Text="Haiku is fastest and cheapest. Sonnet reads messy or long screenshots more accurately."/>

    <TextBlock Text="Your name and initials" Margin="0,14,0,4" FontWeight="SemiBold"/>
    <TextBox x:Name="NameBox" Padding="4,4"/>
    <TextBlock Margin="0,4,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
               Text="Helps Claude pick out your actions in meeting minutes, e.g. Gustav Basch (GB)."/>

    <TextBlock Text="Tags (comma separated)" Margin="0,14,0,4" FontWeight="SemiBold"/>
    <TextBox x:Name="TagsBox" Padding="4,4"/>

    <CheckBox x:Name="HoverBox" Content="Open the list when I hover over the icon" Margin="0,16,0,0"/>
    <CheckBox x:Name="StartupBox" Content="Start TodoEdge when Windows starts" Margin="0,8,0,0"/>

    <TextBlock Margin="0,16,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap">
      Shortcuts: Ctrl+Shift+T reads a screenshot area. Ctrl+Shift+Y reads text or an image you copied.
      Ctrl+Shift+D starts dictation.
      Your list is saved in %AppData%\TodoEdge.
    </TextBlock>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
