<Window x:Class="TodoEdge.TodoPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TodoEdge"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="384" SizeToContent="Height"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Border Margin="12" Background="White" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Grid.Row="0" Margin="14,10,8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="To-do" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
          <TextBlock x:Name="CountText" Margin="8,1,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE722;"
                ToolTip="Add from screenshot (Ctrl+Shift+T)" Click="Capture_Click"/>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE77F;"
                ToolTip="Add from clipboard (Ctrl+Shift+Y)" Click="Clipboard_Click"/>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;"
                ToolTip="Settings" Click="Settings_Click"/>
      </Grid>

      <!-- Busy -->
      <StackPanel Grid.Row="1" x:Name="BusyPanel" Margin="14,0,14,6" Visibility="Collapsed">
        <TextBlock x:Name="BusyText" Text="Reading screenshot..." Foreground="{StaticResource Muted}" FontSize="12"/>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0" BorderThickness="0"
                     Foreground="{StaticResource Accent}" Background="#E5E7EB"/>
      </StackPanel>

      <!-- Undo -->
      <Border Grid.Row="2" x:Name="UndoBar" Margin="10,0,10,6" Padding="10,6" CornerRadius="6"
              Background="#111827" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="UndoText" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Style="{StaticResource LinkButton}" Margin="10,0,0,0" Click="Undo_Click">
            <TextBlock Text="Undo" Foreground="#93C5FD" FontWeight="SemiBold"/>
          </Button>
        </Grid>
      </Border>

      <!-- Open items -->
      <ScrollViewer Grid.Row="3" x:Name="ListScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                    Background="Transparent">
        <ScrollViewer.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Add item" Click="AddItemMenu_Click"/>
            <MenuItem Header="Add from screenshot" InputGestureText="Ctrl+Shift+T" Click="Capture_Click"/>
            <MenuItem Header="Add from clipboard" InputGestureText="Ctrl+Shift+Y" Click="Clipboard_Click"/>
            <Separator/>
            <MenuItem Header="Clear completed" Click="ClearCompleted_Click"/>
          </ContextMenu>
        </ScrollViewer.ContextMenu>
        <StackPanel Margin="6,0,6,0">
          <TextBlock x:Name="EmptyText" Margin="10,14,10,18" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                     Text="Nothing to do. Type below, right-click to add, or press Ctrl+Shift+T to read a screenshot."/>
          <ItemsControl x:Name="OpenList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row" Padding="8,7" CornerRadius="6" Background="Transparent" Tag="{Binding}"
                        MouseLeftButtonDown="Row_MouseLeftButtonDown" ContextMenuOpening="Row_ContextMenuOpening">
                  <Border.ContextMenu>
                    <ContextMenu/>
                  </Border.ContextMenu>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="3" CornerRadius="1.5" Margin="0,1,7,1" Background="{Binding TagBrush}"/>
                    <CheckBox Grid.Column="1" VerticalAlignment="Top" Margin="0,2,10,0" Tag="{Binding}"
                              Checked="Item_Checked" Cursor="Hand"/>
                    <StackPanel Grid.Column="2">
                      <TextBlock x:Name="TitleText" Text="{Binding Title}" TextWrapping="Wrap" Foreground="#111827"/>
                      <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=Explicit}" TextWrapping="Wrap"
                               Visibility="Collapsed" Tag="{Binding}" Padding="2,1"
                               KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostKeyboardFocus"
                               IsVisibleChanged="TitleBox_IsVisibleChanged"/>
                      <TextBlock x:Name="Sub" Text="{Binding Subtitle}" FontSize="11.5" Margin="0,2,0,0"
                                 Foreground="{StaticResource Muted}"
                                 Visibility="{Binding HasSubtitle, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#F3F4F6"/>
                  </Trigger>
                  <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TitleBox" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="Sub" Property="Foreground" Value="#DC2626"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Completed toggle -->
      <Button Grid.Row="4" x:Name="DoneToggle" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
              Margin="16,6,0,2" Click="DoneToggle_Click">
        <TextBlock x:Name="DoneToggleText" Text="Show completed" FontSize="12" Foreground="{StaticResource Muted}"/>
      </Button>

      <!-- Completed items -->
      <ScrollViewer Grid.Row="5" x:Name="DoneScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
        <ItemsControl x:Name="DoneList" Margin="6,0,6,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="8,5" Tag="{Binding}" ContextMenuOpening="Row_ContextMenuOpening" Background="Transparent">
                <Border.ContextMenu>
                  <ContextMenu/>
                </Border.ContextMenu>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="True" Margin="10,2,10,0" VerticalAlignment="Top" Tag="{Binding}"
                            Unchecked="DoneItem_Unchecked" Cursor="Hand" ToolTip="Restore"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" Foreground="#9CA3AF"
                             TextDecorations="Strikethrough"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Add bar -->
      <Grid Grid.Row="6" Margin="10,6,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="AddBorder" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" Background="White">
          <Grid>
            <TextBlock x:Name="AddPlaceholder" Text="Add a to-do, or Ctrl+Enter to let Claude sort it" Foreground="#9CA3AF"
                       IsHitTestVisible="False" VerticalAlignment="Center"/>
            <TextBox x:Name="AddBox" BorderThickness="0" Background="Transparent" Padding="0"
                     VerticalAlignment="Center" KeyDown="AddBox_KeyDown" TextChanged="AddBox_TextChanged"/>
          </Grid>
        </Border>
        <Button Grid.Column="1" x:Name="MicButton" Margin="6,0,0,0" Style="{StaticResource IconButton}" Content="&#xE720;"
                FontSize="16" Width="32" Height="32" ToolTip="Dictate to-dos (Ctrl+Shift+D)" Click="Mic_Click"/>
        <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource AddButton}" Content="&#xE710;"
                ToolTip="Add item" Click="AddButton_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
